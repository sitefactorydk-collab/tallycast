{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tallycast",
  "version": "0.4.0",
  "identifier": "app.tallycast.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Tallycast",
        "width": 1080,
        "height": 700,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": false,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Video",
    "shortDescription": "Screen recorder",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZERDAwNjZFRUVDNkM0NTgKUldSWXhNYnViZ2JRL1RTUmIzc2VVUGpkOVVJdTlPZnluUjMrUE5wSll6UitYZGZzeVpRb1hpdDIK",
      "endpoints": [
        "https://github.com/sitefactorydk-collab/tallycast/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
