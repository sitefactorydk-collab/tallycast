{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "beforeDevCommand": {
      "script": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-ffmpeg.ps1",
      "wait": true
    },
    "beforeBuildCommand": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-ffmpeg.ps1"
  },
  "bundle": {
    "targets": ["nsis"],
    "externalBin": ["binaries/ffmpeg"],
    "publisher": "Tallycast",
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}
